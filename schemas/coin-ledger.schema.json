{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solana coin collection ledger v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mint",
    "launch_venue",
    "launch_time_utc",
    "state",
    "attempt_count",
    "requested_window",
    "streams",
    "validation",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "mint": {
      "type": "string",
      "minLength": 32,
      "maxLength": 44
    },
    "launch_venue": {
      "enum": [
        "pumpfun",
        "stonkfun"
      ]
    },
    "launch_signature": {
      "type": [
        "string",
        "null"
      ]
    },
    "launch_time_utc": {
      "type": "string",
      "format": "date-time"
    },
    "discovery_source": {
      "type": "string"
    },
    "state": {
      "enum": [
        "DISCOVERED",
        "QUEUED",
        "COLLECTING",
        "VALIDATING",
        "PUBLISHING",
        "COMPLETE",
        "RETRY",
        "INCOMPLETE",
        "DATA_UNAVAILABLE",
        "REJECTED"
      ]
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "lease_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "requested_window": {
      "type": "object",
      "required": [
        "start_utc",
        "end_utc"
      ],
      "properties": {
        "start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "end_utc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "actual_coverage": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "start_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage_seconds": {
          "type": "number",
          "minimum": 0
        },
        "gap_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "streams": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "record_count",
          "distinct_signature_count",
          "duplicate_count"
        ],
        "properties": {
          "status": {
            "enum": [
              "complete",
              "partial",
              "empty_verified",
              "unavailable",
              "not_requested",
              "failed"
            ]
          },
          "record_count": {
            "type": "integer",
            "minimum": 0
          },
          "distinct_signature_count": {
            "type": "integer",
            "minimum": 0
          },
          "duplicate_count": {
            "type": "integer",
            "minimum": 0
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "pages": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "level",
        "errors"
      ],
      "properties": {
        "level": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "METADATA_ONLY",
            "INVALID"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "dataset_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "hf_commit_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "retry_after_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
