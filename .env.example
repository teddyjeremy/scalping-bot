# Add three Helius mainnet API keys. Never commit real keys.
HELIUS_API_KEY_1=
HELIUS_API_KEY_2=
HELIUS_API_KEY_3=

# Optional: maximum age of each token capture in minutes (default 10)
CAPTURE_MINUTES=10

# Optional: data directory (must be on persistent storage in production)
DATA_DIR=./data
# Hugging Face dataset uploads (create a write token at huggingface.co/settings/tokens)
HF_TOKEN=
HF_DATASET_REPO=ndeda/solana-scalping-data
